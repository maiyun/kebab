{
  "name": "@maiyunnet/kebab",
  "version": "9.26.5",
  "description": "Simple, easy-to-use, and fully-featured Node.js framework that is ready-to-use out of the box.",
  "type": "module",
  "keywords": [
    "kebab",
    "node",
    "framework"
  ],
  "main": "index.js",
  "author": "hanguoshuai",
  "license": "Apache-2.0",
  "types": "./index.d.ts",
  "scripts": {
    "build-doc": "bash ./utils/build-doc.sh",
    "test:formdata": "node abox/test/formdata.mjs",
    "test:session": "node abox/test/session.mjs",
    "test:rpc": "node --test --test-isolation=none abox/test/rpc.mjs",
    "test:master": "node --test --test-isolation=none abox/test/master.mjs"
  },
  "bin": {
    "kebab": "./bin/kebab.js"
  },
  "imports": {
    "#kebab/*": "./*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@litert/http-client": "^1.2.0",
    "@litert/mime": "^2.0.0",
    "@litert/redis": "^3.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/cli": "^4.3.4",
    "@types/ssh2": "^1.15.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "ssh2": "^1.17.0",
    "svg-captcha": "^1.4.0",
    "tailwind-merge": "^3.7.0",
    "tencentcloud-sdk-nodejs": "^4.1.338",
    "undici": "^8.12.3",
    "valibot": "^1.5.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@litert/eslint-plugin-rules": "^0.3.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true,
    "cpu-features": true,
    "ssh2": true
  }
}
